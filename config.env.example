# ==============================================================================
#  PROXMOX SMART BACKUP - Configuración del servidor (única plantilla)
# ==============================================================================
#  El instalador copia este archivo a /etc/proxmox-backup/config.env.
#  Edita config.env en el servidor para cambiar rutas, frecuencias, Telegram, etc.
#  Todas las variables son opcionales (hay valores por defecto en el script).
#
#  Replicabilidad: BACKUP_DIR y DATA_DIR pueden ser cualquier ruta.
# ==============================================================================

# --- TELEGRAM (notificaciones) ---
# Token: @BotFather en Telegram. Chat ID: @userinfobot o @getidsbot
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- FRECUENCIAS ---
# Cada cuántos días se suben VMs y datos completos a la nube (solo configs se suben a diario)
CLOUD_SYNC_DAYS=3

# --- RUTAS LOCALES ---
# Directorio raíz de backups (debe existir y ser escribible)
# BACKUP_DIR="/mnt/backups"
# Directorio de datos a sincronizar a la nube (rclone sync)
# DATA_DIR="/mnt/data"

# --- ALMACENAMIENTO PROXMOX ---
# ID del storage en Proxmox (Datacenter > Storage). Debe tener retención configurada (ej. Keep Last=3)
# PROXMOX_STORAGE_ID="backups-vms"

# --- NUBE (rclone) ---
# Remote de rclone (ej. gdrive). Configurar con: rclone config
# RCLONE_REMOTE="gdrive"
# Carpeta raíz en Drive
# GDRIVE_ROOT="Server Backups"
# Subcarpeta para configs + dumps de VMs
# GDRIVE_SYSTEM="Proxmox System"
# Subcarpeta para datos (/mnt/data)
# GDRIVE_DATA="Proxmox Data"

# --- ESTADO DE SINCRONIZACIÓN ---
# Archivo que guarda la última vez que se hizo sync completo a la nube (no editar)
# SYNC_STATE_FILE="/var/tmp/proxmox-backup-last-sync"
